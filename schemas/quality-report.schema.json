{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/comeredon/copilot-agentic-delivery-center/schemas/quality-report.schema.json",
  "title": "Quality gate report",
  "description": "Deterministic quality gate output. The 'canonical' object is the only part that is hashed; anything non-reproducible lives in 'envelope' and is excluded from the hash.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "canonical",
    "canonicalHash",
    "envelope"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "canonical": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commit",
        "profile",
        "verdict",
        "checks"
      ],
      "properties": {
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{7,40}$|^unknown$"
        },
        "profile": {
          "type": "string",
          "enum": [
            "cloud",
            "ci",
            "local"
          ]
        },
        "verdict": {
          "type": "string",
          "enum": [
            "pass",
            "fail",
            "inconclusive"
          ]
        },
        "checks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "required",
              "passed",
              "detail"
            ],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]*$"
              },
              "required": {
                "type": "boolean"
              },
              "passed": {
                "type": "boolean"
              },
              "detail": {
                "type": "string",
                "maxLength": 2048
              }
            }
          }
        }
      }
    },
    "canonicalHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "envelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "generatedAtUtc",
        "toolVersion",
        "durationsMs"
      ],
      "properties": {
        "generatedAtUtc": {
          "type": "string",
          "format": "date-time"
        },
        "toolVersion": {
          "type": "string"
        },
        "durationsMs": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  }
}
