@page "/evidence"
@rendermode InteractiveServer
@inject DeliveryApiClient Api

<PageTitle>Evidence</PageTitle>

<h1>Evidence explorer</h1>
<p class="muted">
    Every gated work item, with its recorded evidence. This is the audit trail an agent cannot
    edit after the fact: the ledger is hash chained and the reports are content addressed.
</p>

@if (_rows.Count == 0)
{
    <p class="muted">Nothing gated yet.</p>
}
else
{
    <table class="data-table">
        <thead><tr><th>#</th><th>Title</th><th>Stage</th><th>Gate verdict</th><th>Canonical hash</th><th>Evidence</th></tr></thead>
        <tbody>
        @foreach (var row in _rows)
        {
            <tr>
                <td><a href="@($"work-items/{row.Detail.Summary.Id}")">@row.Detail.Summary.Number</a></td>
                <td>@row.Detail.Summary.Title</td>
                <td>@row.Detail.Summary.Stage</td>
                <td class="@(row.Detail.LatestGate?.Verdict == "Pass" ? "ok" : "warn")">
                    @(row.Detail.LatestGate?.Verdict ?? "none")
                </td>
                <td><code>@(row.Detail.LatestGate is null ? "-" : row.Detail.LatestGate.CanonicalHash[..12])</code></td>
                <td>@row.Detail.Evidence.Count</td>
            </tr>
        }
        </tbody>
    </table>
}

@code {
    private readonly List<EvidenceRow> _rows = [];

    protected override async Task OnInitializedAsync()
    {
        var items = await Api.GetWorkItemsAsync();

        foreach (var item in items)
        {
            var detail = await Api.GetWorkItemAsync(item.Id);
            if (detail is not null && (detail.LatestGate is not null || detail.Evidence.Count > 0))
            {
                _rows.Add(new EvidenceRow(detail));
            }
        }
    }

    private sealed record EvidenceRow(WorkItemDetailDto Detail);
}
