@page "/operations"
@rendermode InteractiveServer
@inject DeliveryApiClient Api
@inject DeliveryRealtimeClient Realtime
@implements IAsyncDisposable

<PageTitle>Operations</PageTitle>

<h1>Operations</h1>

<section class="panel">
    <h2>Sync health</h2>
    @if (_sync is null)
    {
        <p class="muted">No sync data.</p>
    }
    else
    {
        <p class="muted">
            Project writes are
            <strong class="@(_sync.ProjectWritesEnabled ? "warn" : "ok")">
                @(_sync.ProjectWritesEnabled ? "enabled" : "disabled")
            </strong>.
        </p>
        <table class="data-table">
            <thead><tr><th>Feed</th><th>Last synced</th><th>Failures</th><th>Dead lettered</th><th>Last error</th></tr></thead>
            <tbody>
            @foreach (var feed in _sync.Feeds)
            {
                <tr>
                    <td>@feed.Feed</td>
                    <td>@(feed.LastSyncedAtUtc?.ToString("u") ?? "never")</td>
                    <td>@feed.ConsecutiveFailures</td>
                    <td class="@(feed.DeadLettered ? "warn" : "ok")">@(feed.DeadLettered ? "yes" : "no")</td>
                    <td>@(feed.LastError ?? "-")</td>
                </tr>
            }
            </tbody>
        </table>
    }
</section>

<section class="panel">
    <h2>Cache</h2>
    @if (_cache is null)
    {
        <p class="muted">No cache data.</p>
    }
    else
    {
        <div class="metric-grid">
            <div class="metric"><span class="metric-value">@_cache.Hits</span><span class="metric-label">Hits</span></div>
            <div class="metric"><span class="metric-value">@_cache.Misses</span><span class="metric-label">Misses</span></div>
            <div class="metric"><span class="metric-value">@_cache.Invalidations</span><span class="metric-label">Invalidations</span></div>
            <div class="metric @(_cache.Errors > 0 ? "metric-alert" : string.Empty)"><span class="metric-value">@_cache.Errors</span><span class="metric-label">Errors</span></div>
            <div class="metric"><span class="metric-value">@_cache.HitRatio.ToString("P0")</span><span class="metric-label">Hit ratio</span></div>
        </div>
    }
</section>

@code {
    private SyncHealthDto? _sync;
    private CacheHealthDto? _cache;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
        Realtime.Changed += OnChangedAsync;
        await Realtime.EnsureConnectedAsync();
    }

    private async Task LoadAsync()
    {
        _sync = await Api.GetSyncHealthAsync();
        _cache = await Api.GetCacheHealthAsync();
    }

    private async Task OnChangedAsync(DeliveryNotification notification)
    {
        await LoadAsync();
        await InvokeAsync(StateHasChanged);
    }

    public ValueTask DisposeAsync()
    {
        Realtime.Changed -= OnChangedAsync;
        return ValueTask.CompletedTask;
    }
}
