@page "/work-items/{Id:guid}"
@rendermode InteractiveServer
@inject DeliveryApiClient Api

<PageTitle>Work item</PageTitle>

@if (_detail is null)
{
    <h1>Work item</h1>
    <p class="muted">Not found, or the API is unreachable.</p>
}
else
{
    <h1>#@_detail.Summary.Number &mdash; @_detail.Summary.Title</h1>
    <p class="muted">
        @_detail.Summary.Kind &middot; @_detail.Summary.State &middot;
        stage <strong>@_detail.Summary.Stage</strong> &middot; risk @_detail.Summary.Risk
        &middot; <a href="@_detail.Summary.Url" target="_blank" rel="noopener noreferrer">open on GitHub</a>
    </p>

    <section class="panel">
        <h2>Human authorization</h2>
        <p class="muted">
            An agent can reach the gate, but only the repository owner can authorize the merge.
            Every attempt is written to the audit log, allowed or not.
        </p>
        <div class="filter-bar">
            <input class="filter-input" placeholder="GitHub login" @bind="_actor" />
            <button class="btn" disabled="@(_busy || _detail.Summary.HumanAuthorized)" @onclick="AuthorizeAsync">
                @(_detail.Summary.HumanAuthorized ? "Already authorized" : "Authorize merge")
            </button>
        </div>
        @if (!string.IsNullOrEmpty(_message))
        {
            <p class="@(_authorized ? "ok" : "warn")">@_message</p>
        }
    </section>

    <section class="panel">
        <h2>Latest quality gate</h2>
        @if (_detail.LatestGate is null)
        {
            <p class="muted">No gate report yet.</p>
        }
        else
        {
            <p class="muted">
                Profile @_detail.LatestGate.Profile &middot; verdict <strong>@_detail.LatestGate.Verdict</strong> &middot;
                commit <code>@_detail.LatestGate.Commit</code> &middot; hash <code>@_detail.LatestGate.CanonicalHash</code>
            </p>
            <table class="data-table">
                <thead><tr><th>Check</th><th>Result</th><th>Detail</th></tr></thead>
                <tbody>
                @foreach (var check in _detail.LatestGate.Checks)
                {
                    <tr>
                        <td>@check.Name</td>
                        <td class="@(check.Passed ? "ok" : "warn")">@(check.Passed ? "pass" : "fail")</td>
                        <td>@check.Detail</td>
                    </tr>
                }
                </tbody>
            </table>
        }
    </section>

    <section class="panel">
        <h2>Gate ledger</h2>
        @if (_detail.Ledger.Count == 0)
        {
            <p class="muted">No ledger entries.</p>
        }
        else
        {
            <table class="data-table">
                <thead><tr><th>#</th><th>Proposer</th><th>Verifier</th><th>Agreed</th><th>Hash</th></tr></thead>
                <tbody>
                @foreach (var entry in _detail.Ledger)
                {
                    <tr>
                        <td>@entry.Sequence</td>
                        <td>@entry.ProposerAgent (@entry.ProposerModel) &rarr; @entry.ProposerVerdict</td>
                        <td>@entry.VerifierAgent (@entry.VerifierModel) &rarr; @entry.VerifierVerdict</td>
                        <td class="@(entry.Agreed ? "ok" : "warn")">@(entry.Agreed ? "yes" : "no")</td>
                        <td><code>@entry.EntryHash[..12]</code></td>
                    </tr>
                }
                </tbody>
            </table>
        }
    </section>

    <section class="panel">
        <h2>Agent evidence</h2>
        @if (_detail.Evidence.Count == 0)
        {
            <p class="muted">No evidence recorded.</p>
        }
        else
        {
            <ul class="evidence-list">
            @foreach (var item in _detail.Evidence)
            {
                <li>
                    <span class="badge badge-@item.Severity.ToLowerInvariant()">@item.Severity</span>
                    <strong>@item.Source</strong> &middot; @item.Summary
                    <span class="muted">(@item.Model, @item.RecordedAtUtc.ToString("u"))</span>
                </li>
            }
            </ul>
        }
    </section>
}

@code {
    [Parameter]
    public Guid Id { get; set; }

    private WorkItemDetailDto? _detail;
    private string _actor = string.Empty;
    private string? _message;
    private bool _authorized;
    private bool _busy;

    protected override async Task OnParametersSetAsync() => _detail = await Api.GetWorkItemAsync(Id);

    private async Task AuthorizeAsync()
    {
        _busy = true;
        try
        {
            (_authorized, _message) = await Api.AuthorizeAsync(Id, _actor);
            _detail = await Api.GetWorkItemAsync(Id);
        }
        finally
        {
            _busy = false;
        }
    }
}
