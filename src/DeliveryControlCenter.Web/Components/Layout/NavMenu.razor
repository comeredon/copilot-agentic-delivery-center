@inject StoreCart Cart
@implements IDisposable

<nav class="site-nav" aria-label="Main navigation">
    <NavLink class="nav-link" href="" Match="NavLinkMatch.All">Home</NavLink>
    <NavLink class="nav-link" href="shop">Coffee</NavLink>
    <NavLink class="nav-link" href="brew-lab">Brew lab</NavLink>
    <NavLink class="nav-link" href="transparency">Our sourcing</NavLink>
    <NavLink class="cart-link" href="cart" aria-label="@($"Shopping bag with {Cart.ItemCount} items")">
        Bag <span class="cart-count">@Cart.ItemCount</span>
    </NavLink>
</nav>

@code {
    protected override void OnInitialized() => Cart.Changed += HandleCartChanged;

    private void HandleCartChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Cart.Changed -= HandleCartChanged;
}
